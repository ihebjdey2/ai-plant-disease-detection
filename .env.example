# Required in production. A temporary key is generated locally when omitted.
SECRET_KEY=replace-with-a-long-random-value
FLASK_ENV=development

# PostgreSQL will be enabled in phase 2.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/plant_disease

# Optional integrations.
WEATHER_API_KEY=
# Configure a provider implementation before setting this in production.
MODEL_PATH=plant_disease_model.h5
UPLOAD_FOLDER=static/uploads
PREDICTION_CONFIDENCE_THRESHOLD=60
